---
interface Props { lang: 'en' | 'ja'; }
const { lang } = Astro.props;
const en = lang === 'en';
const nav = en
  ? [['#about','About'],['#flagship','Flagship'],['#works','Works'],['#matrix','Somme Matrix'],['#writing','Writing'],['#experience','Experience'],['#contact','Contact']]
  : [['#about','自己紹介'],['#flagship','代表作'],['#works','作品'],['#experience','経歴'],['#contact','連絡先']];
---
<aside>
  <div>
    <h1>高凌霄<span class="handle">@Toygaolingxiao</span></h1>
    <div class="role">{en ? 'Senior Consultant — AI & Smart Manufacturing' : 'シニアコンサルタント — AI × スマート製造'}</div>
    <p class="positioning">{en
      ? <>I help semiconductor fab teams make their schedules <strong>explainable</strong> — <strong>rules decide, AI explains.</strong></>
      : <><strong>ルールが決め、AIが説明する。</strong>半導体fabのスケジュールを「説明できる」ものにします。</>}
    </p>
    <div class="loc">{en ? 'Tokyo, Japan' : '東京'}</div>
    <nav>
      <ul>
        {nav.map(([href, label]) => <li><a href={href}>{label}</a></li>)}
      </ul>
    </nav>
  </div>
  <div class="side-foot">
    <div class="lang">{en ? <><b>EN</b> · <a href="/ja/">日本語</a></> : <><a href="/">English</a> · <b>日本語</b></>}</div>
    <div class="social">
      <a href="https://github.com/Toygaolingxiao" aria-label="GitHub"><svg viewBox="0 0 24 24"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-2.15c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.69 1.25 1.85-.75.4-1.25.7-1.54-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.8 0c2.21-1.49 3.18-1.18 3.18-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 1.28 1.06.78 2.14 0 1.53-.01 1.08-.01 2.18 0 .21.14.46.8.38A10.52 10.52 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"/></svg></a>
    </div>
  </div>
</aside>
